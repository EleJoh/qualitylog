---
import Button from "../components/Button.astro";
---

<section id="video" class="bg-bgWhite px-6 lg:px-16 py-16">
  <div class="max-w-screen-xl mx-auto">
    <div class="bg-bgDarker rounded-3xl p-8 lg:p-12 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <!-- Left: text + illustration -->
      <div class="reveal-card flex flex-col gap-6">
        <h2 class="text-h4bold_mobile lg:text-h4bold text-black">
          Mere <span class="text-brand">effektiv</span> hverdag
        </h2>
        <p class="text-p_mobile lg:text-p text-gray max-w-lg">Få et hurtigt overblik over, hvordan QualityLog bruges i praksis. På få minutter kan du se, hvordan opgaver oprettes, udføres og dokumenteres.</p>
        <div class="flex items-center gap-4 pt-2">
          <Button href="#book-demo" variant="primary" class="inline-flex"> Book demo </Button>
        </div>
        <!-- Grafik illustration -->
        <div class="mt-4 max-w-xs">
          <img src="/grafik_big.webp" alt="Kort over QualityLog" />
        </div>
      </div>

      <!-- Right: coming soon placeholder -->
      <div class="reveal-card relative bg-bgDark rounded-2xl overflow-hidden aspect-video flex items-center justify-center">
        <!-- Gradient background -->
        <div class="absolute inset-0 bg-Darker"></div>

        <!-- Content -->
        <div class="relative z-10 flex flex-col items-center gap-4 text-center px-6">
          <!-- Icon -->
          <div class="w-16 h-16 rounded-full bg-grey/10 flex items-center justify-center">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <path d="M8 5.14v13.72a1 1 0 001.5.86l10-6.86a1 1 0 000-1.72l-10-6.86A1 1 0 008 5.14z" fill="grey" opacity="0.6"></path>
            </svg>
          </div>

          <!-- Text -->
          <div class="flex flex-col gap-1">
            <span class="text-grey text-h5_mobile lg:text-h5">Video kommer snart</span>
            <span class="text-grey text-ps_mobile lg:text-ps">Vi arbejder på det</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
