---
import Button from "../components/Button.astro";
---

<section id="video" class="bg-bgWhite px-6 lg:px-16 py-16">
  <div class="max-w-screen-xl mx-auto">
    <div class="bg-bgDarker rounded-3xl p-8 lg:p-12 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <!-- Left: text + illustration -->
      <div class="reveal-card flex flex-col gap-6">
        <h2 class="text-h4bold_mobile lg:text-h4bold text-black">
          Mere <span class="text-brand">effektiv</span> hverdag
        </h2>
        <p class="text-p_mobile lg:text-p text-grey max-w-lg">Få et hurtigt overblik over, hvordan QualityLog bruges i praksis. På få minutter kan du se, hvordan opgaver oprettes, udføres og dokumenteres.</p>
        <div class="flex items-center gap-4 pt-2">
          <Button href="#book-demo" variant="primary" class="inline-flex"> Book demo </Button>
        </div>
        <!-- Grafik illustration -->
        <div class="mt-4 max-w-xs">
          <img src="/grafik_big.webp" alt="Kort over QualityLog" />
        </div>
      </div>

      <!-- Right: video player -->
      <div class="reveal-card relative bg-bgDark rounded-2xl overflow-hidden aspect-video flex items-center justify-center group cursor-pointer" id="video-container">
        <!-- Thumbnail placeholder -->
        <div class="absolute inset-0 bg-gradient-to-br from-bgDark to-bgDarker"></div>

        <!-- Play button -->
        <button id="play-btn" aria-label="Afspil video" class="relative z-10 w-16 h-16 rounded-full bg-white/80 hover:bg-white flex items-center justify-center shadow-md transition-all group-hover:scale-110">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M8 5.14v13.72a1 1 0 001.5.86l10-6.86a1 1 0 000-1.72l-10-6.86A1 1 0 008 5.14z" fill="#1F4569"></path>
          </svg>
        </button>

        <!-- Actual video -->
        <video id="onboarding-video" class="absolute inset-0 w-full h-full object-cover hidden" controls src="/onboarding-video.mp4"></video>
      </div>
    </div>
  </div>
</section>

<script>
  const playBtn = document.getElementById("play-btn");
  const video = document.getElementById("onboarding-video") as HTMLVideoElement;
  const container = document.getElementById("video-container");

  playBtn?.addEventListener("click", () => {
    playBtn.classList.add("hidden");
    video?.classList.remove("hidden");
    video?.play();
  });
</script>
