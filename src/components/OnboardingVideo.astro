---
import Button from "../components/Button.astro";
---

<section id="video" class="bg-bgWhite px-6 lg:px-16 py-16">
  <div class="max-w-screen-xl mx-auto">
    <div class="bg-bgDarker rounded-3xl p-8 lg:p-2 lg:px-16 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <!-- Left: text + illustration -->
      <div class="reveal-card flex flex-col gap-6">
        <h2 class="text-h4bold_mobile lg:text-h4bold text-black lg:pt-16">
          Se appen <span class="text-brand">i brug</span> 
        </h2>
        <p class="text-p_mobile lg:text-p text-gray max-w-lg">På et minut kan du se et eksempel på, hvordan inspektionsarbejde udføres og dokumenteres.</p>
        <div class="flex items-center gap-16 pt-2">
          <Button href="/om#book_demo" variant="primary" class="inline-flex"> Book demo </Button>
        </div>
        <!-- Grafik illustration -->
        <div class="max-w-xs lg:ml-48 lg:-translate-y-16">
          <img src="/grafik_big.webp" alt="Kort over QualityLog" />
        </div>
      </div>

<!-- Video player  -->
<div id="player-wrap" class="reveal-card relative bg-bgDarker rounded-2xl overflow-hidden aspect-video group">

  <!-- Video element -->
  <video
    id="vid"
    class="w-full h-full object-cover"
    preload="metadata"
    poster="/video/poster.jpg"
  >
    <source src="/video/video_4.mp4" type="video/mp4" />
  </video>

  <!-- Big centre play button — hidden once video starts -->
  <div
    id="big-play"
    class="absolute inset-0 flex items-center justify-center bg-black/20 transition-opacity duration-300"
  >
    <button
      id="big-play-btn"
      aria-label="Afspil video"
      class="w-16 h-16 flex items-center justify-center rounded-full border-2 border-white/60 bg-white/20 backdrop-blur-sm hover:bg-white/30 transition-colors cursor-pointer"
    >
      <svg width="22" height="22" viewBox="0 0 22 22" fill="none">
        <path d="M6 4l12 7-12 7V4z" fill="white"/>
      </svg>
    </button>
  </div>

  <!-- Controls bar — hidden by default, shown on hover, always visible on touch/mobile -->
  <div
    id="controls"
    class="absolute bottom-0 left-0 right-0
           translate-y-1 opacity-0
           group-hover:translate-y-0 group-hover:opacity-100
           transition-all duration-300 ease-in-out
           bg-gradient-to-t from-black/80 to-transparent
           px-4 pt-8 pb-3 flex flex-col gap-2"
  >
    <!-- Progress bar -->
    <div
      id="progress-wrap"
      class="h-1 bg-white/25 rounded-full relative cursor-pointer group/progress"
      role="slider"
      aria-label="Videofremgang"
    >
      <!-- Buffered -->
      <div id="progress-buffer" class="absolute h-full bg-white/20 rounded-full w-0"></div>
      <!-- Played -->
      <div id="progress-fill" class="h-full bg-white rounded-full w-0 relative">
        <!-- Scrubber dot -->
        <div class="absolute right-0 top-1/2 -translate-y-1/2 w-3 h-3 bg-white rounded-full
                    opacity-0 group-hover/progress:opacity-100 transition-opacity shadow"></div>
      </div>
    </div>

    <!-- Bottom row -->
    <div class="flex items-center gap-3">

      <!-- Play / Pause -->
      <button id="play-btn" aria-label="Afspil/pause" class="text-white hover:text-white/70 transition-colors">
        <svg id="icon-play" width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M4 3l11 6-11 6V3z" fill="currentColor"/>
        </svg>
        <svg id="icon-pause" width="18" height="18" viewBox="0 0 18 18" fill="none" class="hidden">
          <rect x="3" y="3" width="4" height="12" rx="1" fill="currentColor"/>
          <rect x="11" y="3" width="4" height="12" rx="1" fill="currentColor"/>
        </svg>
      </button>

      <!-- Restart -->
      <button id="restart-btn" aria-label="Start forfra" class="text-white/60 hover:text-white transition-colors">
       
      </button>

      <!-- Time -->
      <span id="time-display" class="text-xs text-white/60 tabular-nums min-w-[80px]">0:00 / 0:00</span>

      <div class="flex-1"></div>

      <!-- Mute + Volume -->
      <div class="flex items-center gap-2">
        <button id="mute-btn" aria-label="Slå lyd til/fra" class="text-white/70 hover:text-white transition-colors">
          <svg id="icon-vol" width="18" height="18" viewBox="0 0 18 18" fill="none">
            <path d="M3 6.5H6l4-3v11l-4-3H3V6.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M13 5.5a4.5 4.5 0 010 7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
            <path d="M11 7.5a2 2 0 010 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
          <svg id="icon-muted" width="18" height="18" viewBox="0 0 18 18" fill="none" class="hidden">
            <path d="M3 6.5H6l4-3v11l-4-3H3V6.5z" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/>
            <path d="M13 6.5l3 3m0-3l-3 3" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
          </svg>
        </button>
        <input
          id="vol-slider"
          type="range" min="0" max="1" step="0.05" value="1"
          aria-label="Lydstyrke"
          class="w-16 h-1 accent-white cursor-pointer"
        />
      </div>

      <!-- Fullscreen -->
      <button id="fs-btn" aria-label="Fuld skærm" class="text-white/70 hover:text-white transition-colors">
        <svg id="icon-expand" width="18" height="18" viewBox="0 0 18 18" fill="none">
          <path d="M2 6V2h4M12 2h4v4M16 12v4h-4M6 16H2v-4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
        <svg id="icon-compress" width="18" height="18" viewBox="0 0 18 18" fill="none" class="hidden">
          <path d="M6 2v4H2M12 2v4h4M16 12h-4v4M2 12h4v4" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </button>

    </div>
  </div>
</div>

</section>

<script>
  const vid         = document.getElementById("vid")          as HTMLVideoElement;
  const bigPlay     = document.getElementById("big-play")     as HTMLElement;
  const bigPlayBtn  = document.getElementById("big-play-btn") as HTMLButtonElement;
  const controls    = document.getElementById("controls")     as HTMLElement;
  const playBtn     = document.getElementById("play-btn")     as HTMLButtonElement;
  const iconPlay    = document.getElementById("icon-play")    as HTMLElement;
  const iconPause   = document.getElementById("icon-pause")   as HTMLElement;
  const restartBtn  = document.getElementById("restart-btn")  as HTMLButtonElement;
  const timeDisplay = document.getElementById("time-display") as HTMLElement;
  const progWrap    = document.getElementById("progress-wrap")    as HTMLElement;
  const progFill    = document.getElementById("progress-fill")    as HTMLElement;
  const progBuffer  = document.getElementById("progress-buffer")  as HTMLElement;
  const muteBtn     = document.getElementById("mute-btn")     as HTMLButtonElement;
  const iconVol     = document.getElementById("icon-vol")     as HTMLElement;
  const iconMuted   = document.getElementById("icon-muted")   as HTMLElement;
  const volSlider   = document.getElementById("vol-slider")   as HTMLInputElement;
  const fsBtn       = document.getElementById("fs-btn")       as HTMLButtonElement;
  const iconExpand  = document.getElementById("icon-expand")  as HTMLElement;
  const iconCompress= document.getElementById("icon-compress")as HTMLElement;
  const playerWrap  = document.getElementById("player-wrap")  as HTMLElement;

  // ── Helpers ───────────────────────────────────────────────────────────────
  function fmt(s: number) {
    const m   = Math.floor(s / 60);
    const sec = Math.floor(s % 60).toString().padStart(2, "0");
    return `${m}:${sec}`;
  }

  function setPlaying(playing: boolean) {
    iconPlay.classList.toggle("hidden", playing);
    iconPause.classList.toggle("hidden", !playing);
  }

  // Controls are ALWAYS hidden on mobile — only hover reveals them (desktop)
  // No touch detection needed — just rely on CSS group-hover which only
  // fires on real pointer devices. Nothing extra needed for mobile.

  let hideTimer: ReturnType<typeof setTimeout>;

  function showControls() {
    controls.classList.remove("opacity-0", "translate-y-1");
    controls.classList.add("opacity-100", "translate-y-0");
    clearTimeout(hideTimer);
    if (!vid.paused) {
      hideTimer = setTimeout(() => {
        controls.classList.add("opacity-0", "translate-y-1");
        controls.classList.remove("opacity-100", "translate-y-0");
      }, 3000);
    }
  }

  function hideControls() {
    if (!vid.paused) {
      hideTimer = setTimeout(() => {
        controls.classList.add("opacity-0", "translate-y-1");
        controls.classList.remove("opacity-100", "translate-y-0");
      }, 800);
    }
  }

  playerWrap.addEventListener("mousemove", showControls);
  playerWrap.addEventListener("mouseleave", hideControls);

  // ── Play / pause ──────────────────────────────────────────────────────────
  function togglePlay() {
    if (vid.paused) {
      vid.play();
      bigPlay.classList.add("opacity-0", "pointer-events-none");
    } else {
      vid.pause();
      bigPlay.classList.remove("opacity-0", "pointer-events-none");
    }
    showControls();
  }

  bigPlayBtn.addEventListener("click", togglePlay);
  playBtn.addEventListener("click", (e) => { e.stopPropagation(); togglePlay(); });
  vid.addEventListener("click", togglePlay);

  vid.addEventListener("play",  () => setPlaying(true));
  vid.addEventListener("pause", () => setPlaying(false));
  vid.addEventListener("ended", () => {
    setPlaying(false);
    bigPlay.classList.remove("opacity-0", "pointer-events-none");
    progFill.style.width = "100%";
  });

  // ── Restart ───────────────────────────────────────────────────────────────
  restartBtn.addEventListener("click", (e) => {
    e.stopPropagation();
    vid.currentTime = 0;
    vid.play();
    bigPlay.classList.add("opacity-0", "pointer-events-none");
    showControls();
  });

  // ── Progress ──────────────────────────────────────────────────────────────
  vid.addEventListener("timeupdate", () => {
    if (!vid.duration) return;
    const pct = (vid.currentTime / vid.duration) * 100;
    progFill.style.width = pct + "%";
    timeDisplay.textContent = `${fmt(vid.currentTime)} / ${fmt(vid.duration)}`;
  });

  vid.addEventListener("progress", () => {
    if (vid.buffered.length > 0 && vid.duration) {
      const buffPct = (vid.buffered.end(vid.buffered.length - 1) / vid.duration) * 100;
      progBuffer.style.width = buffPct + "%";
    }
  });

  function scrubTo(clientX: number) {
    const rect = progWrap.getBoundingClientRect();
    const pct  = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
    vid.currentTime = pct * vid.duration;
  }

  progWrap.addEventListener("click", (e) => { scrubTo(e.clientX); showControls(); });
  let dragging = false;
  progWrap.addEventListener("mousedown", () => { dragging = true; });
  document.addEventListener("mousemove", (e) => { if (dragging) scrubTo(e.clientX); });
  document.addEventListener("mouseup",   () => { dragging = false; });

  // ── Mute / Volume ─────────────────────────────────────────────────────────
  muteBtn.addEventListener("click", (e) => {
    e.stopPropagation();
    vid.muted = !vid.muted;
    iconVol.classList.toggle("hidden", vid.muted);
    iconMuted.classList.toggle("hidden", !vid.muted);
    volSlider.value = vid.muted ? "0" : String(vid.volume);
  });

  volSlider.addEventListener("input", (e) => {
    e.stopPropagation();
    vid.volume = parseFloat(volSlider.value);
    vid.muted  = vid.volume === 0;
    iconVol.classList.toggle("hidden", vid.muted);
    iconMuted.classList.toggle("hidden", !vid.muted);
  });

  // ── Fullscreen ────────────────────────────────────────────────────────────
  fsBtn.addEventListener("click", (e) => {
    e.stopPropagation();
    if (!document.fullscreenElement) {
      playerWrap.requestFullscreen?.();
    } else {
      document.exitFullscreen?.();
    }
  });

  document.addEventListener("fullscreenchange", () => {
    const isFs = !!document.fullscreenElement;
    iconExpand.classList.toggle("hidden", isFs);
    iconCompress.classList.toggle("hidden", !isFs);
    if (isFs) showControls();
  });

  // ── Keyboard shortcuts ────────────────────────────────────────────────────
  document.addEventListener("keydown", (e) => {
    if (e.target !== document.body && e.target !== vid) return;
    if (e.code === "Space")      { e.preventDefault(); togglePlay(); }
    if (e.code === "ArrowRight") { vid.currentTime = Math.min(vid.duration, vid.currentTime + 5); }
    if (e.code === "ArrowLeft")  { vid.currentTime = Math.max(0, vid.currentTime - 5); }
    if (e.code === "KeyM")       { muteBtn.click(); }
    if (e.code === "KeyF")       { fsBtn.click(); }
  });
</script>