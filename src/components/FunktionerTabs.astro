---
const tabs = [
  { label: "Opgavestyring", target: "opgavestyring" },
  { label: "Digital tjekliste", target: "digital-tjekliste" },
  { label: "Dokumentation", target: "dokumentation" },
  { label: "Fejlhåndtering", target: "fejlhaandtering" },
  { label: "Overblik & historik", target: "overblik" },
  { label: "Kommunikation & opfølgning", target: "kommunikation" },
  { label: "Ekstra funktioner", target: "ekstra-funktioner" },
];
---

<section class="bg-bgDarker px-6 lg:px-0 pt-8 lg:pt-16 pb-8">
  <div class="max-w-screen-l mx-auto">
    <div class="flex items-start justify-between gap-8 pb-8">
      <!-- Left: heading + tabs -->
      <div class="reveal-card flex flex-col gap-8 flex-1 lg:pl-48 lg:max-w-4xl">
        <h2 class="text-h3_mobile lg:text-h3 lg:pb-12 pb-4 text-black">Alt samlet et sted</h2>

        <nav class="flex flex-wrap gap-x-8 gap-y-4">
          {
            tabs.map((tab, i) => (
              <button data-tab={i} data-target={tab.target} class={`tab-btn relative text-h6_mobile lg:text-h6 pb-2 transition-colors duration-200 ${i === 0 ? "text-brand font-semibold" : "text-grey hover:text-brand"}`}>
                {tab.label}
                <span class="tab-line absolute bottom-0 left-1/2 -translate-x-1/2 h-[2px] bg-brand rounded-full transition-all duration-300" style={i === 0 ? "width:50%" : "width:0%"} />
              </button>
            ))
          }
        </nav>
      </div>

      <!-- Right: PC graphic -->
      <div class="reveal-card hidden lg:block flex-shrink-0 w-60 xl:w-72 -mt-2" data-direction="right">
        <img src="/grafik_pc.webp" alt="Lokation illustration" class="w-full h-auto object-cover" />
      </div>
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".tab-btn");

  buttons.forEach((btn) => {
    // ── Hover───
    btn.addEventListener("mouseenter", () => {
      const line = btn.querySelector(".tab-line") as HTMLElement;
      if (line) line.style.width = "50%";
    });

    btn.addEventListener("mouseleave", () => {
      const isActive = btn.classList.contains("font-semibold");
      const line = btn.querySelector(".tab-line") as HTMLElement;
      if (line && !isActive) line.style.width = "0%";
    });

    // ── Click: set active + scroll to card ──
    btn.addEventListener("click", () => {
      // 1. Reset all tabs
      buttons.forEach((b) => {
        b.classList.remove("text-brand", "font-semibold");
        b.classList.add("text-grey");
        const l = b.querySelector(".tab-line") as HTMLElement;
        if (l) l.style.width = "0%";
      });

      // 2. Mark this tab as active
      btn.classList.add("text-brand", "font-semibold");
      btn.classList.remove("text-grey");
      const activeLine = btn.querySelector(".tab-line") as HTMLElement;
      if (activeLine) activeLine.style.width = "50%";

      // 3. Scroll smoothly to the matching card
      const targetId = btn.dataset.target;
      if (targetId) {
        const card = document.getElementById(targetId);
        if (card) {
          // Offset by navbar height
          const navbarHeight = 120;
          const top = card.getBoundingClientRect().top + window.scrollY - navbarHeight;
          window.scrollTo({ top, behavior: "smooth" });
        }
      }
    });
  });
</script>
