---
// ScrollReveal.astro
// ─────────────────────────────────────────────────────────────────────────────
//
//
//   reveal-card            → slides in from the left + fades in
//   reveal-card  data-direction="right"  → slides in from the right
//   reveal-up              → fades in from slightly below (headings, text)
//   reveal-left            → always slides in from left (ignore alternating)
//   reveal-right           → always slides in from right
//   data-delay="120"       → delay in ms before the animation fires
//                            use multiples of 60–80ms for stagger groups
// ─────────────────────────────────────────────────────────────────────────────
---

<style is:global>
  /* ── Starting (hidden) states ─────────────────────────────────────────── */

  .reveal-card {
    opacity: 0;
    transform: translateX(-20px);
    transition:
      opacity 600ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .reveal-card[data-direction="right"] {
    transform: translateX(20px);
  }

  .reveal-up {
    opacity: 0;
    transform: translateY(18px);
    transition:
      opacity 550ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 550ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .reveal-left {
    opacity: 0;
    transform: translateX(-20px);
    transition:
      opacity 600ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  .reveal-right {
    opacity: 0;
    transform: translateX(20px);
    transition:
      opacity 600ms cubic-bezier(0.4, 0, 0.2, 1),
      transform 600ms cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* ── Visible state — added by JS when element enters viewport ─────────── */
  .reveal-card.is-visible,
  .reveal-up.is-visible,
  .reveal-left.is-visible,
  .reveal-right.is-visible {
    opacity: 1;
    transform: translate(0, 0);
  }

  /* ── Respect user's reduced-motion preference ─────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .reveal-card,
    .reveal-up,
    .reveal-left,
    .reveal-right {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  function initReveal() {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const el = entry.target as HTMLElement;
          const delay = parseInt(el.dataset.delay ?? "0", 10);

          setTimeout(() => {
            el.classList.add("is-visible");
          }, delay);

          // Animate only once — stop watching after reveal
          observer.unobserve(el);
        });
      },
      {
        threshold: 0.1,
        rootMargin: "0px 0px -40px 0px",
      },
    );

    document.querySelectorAll(".reveal-card, .reveal-up, .reveal-left, .reveal-right").forEach((el) => observer.observe(el));
  }

  // Run on page load
  initReveal();

  // Re-run after Astro view transitions
  document.addEventListener("astro:page-load", initReveal);
</script>
