---
const roles = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#0261AA" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-trending-up"><path stroke="none" d="M0 0h24v24H0z" fill="none" /><path d="M3 17l6 -6l4 4l8 -8" /><path d="M14 7l7 0l0 7" /></svg>`,
    tag: "For Ledere",
    description:
      "Skab en mere professionel oplevelse for dine kunder gennem bedre dokumentation og hurtigere opfølgning. Det kan styrke tilliden og gøre dig mere konkurrencedygtig.",
    features: [
      "Skab større tillid hos dine kunder",
      "Reager hurtigere på problemer og feedback",
      "Brug mindre tid på administration og opgavefølgning",
    ],
    cta: { label: "Book demo", href: "/om#book_demo", primary: true },
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="9" cy="7" r="3" stroke="#0261AA" stroke-width="1.6"/><circle cx="17" cy="10" r="3" stroke="#0261AA" stroke-width="1.6"/><path d="M3 20c0-3.3 2.7-6 6-6h2" stroke="#0261AA" stroke-width="1.6" stroke-linecap="round"/><path d="M13 20c0-3.3 2.7-5 5-5" stroke="#0261AA" stroke-width="1.6" stroke-linecap="round"/></svg>`,
    tag: "For medarbejdere",
    description:
      "Gør hverdagen nemmere med en app, der fungerer som en huskeseddel. Tilføj et billede og en kommentar, hvis noget blokerer arbejdet – uden lange forklaringer eller opkald.",
    features: [
      "Hav altid dine opgaver lige ved hånden",
      "Registrer problemer hurtigt og nemt",
      "Slip for unødvendige opkald og misforståelser",
    ],
    cta: { label: "Se appen i brug", href: "#video", secondary: false },
  },
];
---

<section class="bg-bgWhite px-6 lg:px-16 py-16 lg:py-24">
  <div class="max-w-screen-xl mx-auto flex flex-col gap-12 lg:gap-24">
    <h2 class="reveal-up text-h3_mobile lg:text-h3 text-black text-center">Tilpasset din rolle</h2>

    <div class="reveal-card grid grid-cols-1 lg:grid-cols-2 gap-6">
      {roles.map((role) => (
        <div class="bg-white rounded-2xl p-8 flex flex-col gap-6 shadow-sm border border-graphic/20 transition-transform duration-300 ease-out hover:scale-[1.02] hover:shadow-md cursor-default">

          <!-- Icon + tag -->
          <div class="flex items-center gap-3">
            <div class="w-11 h-11 rounded-xl bg-bgDarker flex items-center justify-center flex-shrink-0">
              <Fragment set:html={role.icon} />
            </div>
            <p class="text-h5_mobile lg:text-h5 font-semibold text-black">{role.tag}</p>
          </div>

          <!-- Description -->
          <p class="text-p_mobile lg:text-p text-grey leading-relaxed lg:py-8 lg:pr-32">{role.description}</p>

          <!-- Feature list -->
          <ul class="flex flex-col gap-5">
            {role.features.map((f) => (
              <li class="flex items-start gap-3">
                <svg class="flex-shrink-0 mt-0.5" width="18" height="18" viewBox="0 0 18 18" fill="none">
                  <circle cx="9" cy="9" r="8" stroke="#0261AA" stroke-width="1.4"/>
                  <path d="M6 9l2 2 4-4" stroke="#0261AA" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="text-p_mobile lg:text-p text-black">{f}</span>
              </li>
            ))}
          </ul>

          <!-- CTA button -->
          <div class="mt-8 pb-4">
            <a
              href={role.cta.href}
              class={`inline-flex text-menu_mobile lg:text-menu font-semibold px-6 py-3 rounded-full transition-colors ${
                role.cta.primary
                  ? "bg-brand text-white hover:bg-icons"
                  : "border bg-buttonLight border-buttonLight text-black hover:bg-bgWhite"
              }`}
            >
              {role.cta.label}
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>