---
const team = [
  {
    name: "Jan Jørgensen",
    role: "Produkt owner",
    photo: "/jan.webp",
  },
  {
    name: "Henrik Stær Grove",
    role: "Operations director",
    photo: "/henrik.webp",
  },
  {
    name: "Thomas Clausen",
    role: "Lead developer",
    photo: "/thomas.webp",
  },
];
---

<section class="bg-bgWhite px-6 lg:px-16 py-16 lg:py-20">
  <div class="reveal-up max-w-screen-xl mx-auto flex flex-col gap-12">

    <!-- Label + heading + description -->
    <div class="flex flex-col items-center gap-4 text-center ">
      <p class=" text-h5timeline_mobile lg:text-h5timeline font-bold text-brand uppercase tracking-widest">Teamet bag</p>
      <p class="text-p_mobile lg:text-p text-grey max-w-4xl lg:py-10">
        Vi er et team med erfaring inden for digital udvikling og brugeroplevelse, der arbejder tæt sammen med virksomheder for at skabe løsninger, der virker i praksis.
      </p>
    </div>

    <!-- Team members -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-10 ">
      {team.map((member) => (
        <div class="flex flex-col items-center gap-4">
          <!-- Circular photo -->
          <div class="w-36 h-36 rounded-full overflow-hidden bg-bgDark flex-shrink-0">
            <img
              src={member.photo}
              alt={member.name}
              class="w-full h-full object-cover grayscale-[80%]"
            />
          </div>
          <div class="text-center flex flex-col gap-1">
            <p class="text-p font-semibold text-black">{member.name}</p>
            <p class="text-p text-grey">{member.role}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
