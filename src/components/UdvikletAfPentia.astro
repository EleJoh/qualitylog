<section class="bg-bgWhite px-6 lg:px-16 py-8 lg:py-2">
  <div class="max-w-screen-xl mx-auto flex flex-col gap-12 lg:gap-8">
    <h2 class="reveal-up text-h3_mobile lg:text-h3 text-black text-center lg:pt-16 lg:pb-8">
      Udviklet af <span class="text-brand">Pentia Aps</span>
    </h2>

    <!-- Card -->
    <div class="reveal-card bg-bgDarker rounded-3xl p-8 lg:p-12 grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
      <!-- Left -->
      <div class="flex flex-col gap-6">
        <div class="flex flex-col gap-4">
          <p class="text-p_mobile lg:text-p text-grey">QualityLog er udviklet af Pentia – et digitalt bureau med stor erfaring i at udvikle brugervenlige digitale løsninger.</p>
          <p class="text-p_mobile lg:text-p text-grey">Med fokus på kvalitet, enkelhed og praksis er QualityLog skabt til at fungere i virkeligheden – ikke kun på papiret.</p>
        </div>

        <!-- Map illustration -->
        <img src="/grafik_big.webp" alt="grafik" class="w-full h-auto" />
      </div>

      <!-- Right -->
      <div class="bg-white rounded-xl flex items-center justify-center p-8 lg:p-0 lg:ml-24 shadow-sm">
        <img src="/pentia_4.webp" alt="Pentia logo" class="w-full h-full object-cover rounded-xl shadow-sm grayscale-[50%]" />
        <span class="text-[48px] font-bold text-black hidden" aria-hidden="true">Pentia</span>
      </div>
    </div>
  </div>
</section>
