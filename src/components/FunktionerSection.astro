---
import FunktionerTabs from "../components/FunktionerTabs.astro";
import FunktionerCard from "../components/FunktionerCard.astro";
---

<FunktionerTabs />

<section class="bg-bgDarker px-6 lg:px-48 pb-16">
  <div class="max-w-screen-xl mx-auto flex flex-col gap-12">
    <FunktionerCard
      id="opgavestyring"
      label="Få styr på opgaver og lokationer"
      title="Opgavestyring i admin panelet"
      description="Opret kunder, lokationer og områder, og definer præcis hvilke opgaver der skal udføres. Alt er samlet ét sted, så medarbejdere altid ved, hvad de skal lave – og hvornår."
      features={[
        {
          text: "Opret opgaver pr. lokation",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2C7.24 2 5 4.46 5 7.5c0 4.1 4.3 9.1 4.72 9.6a.38.38 0 00.56 0C10.7 16.6 15 11.6 15 7.5 15 4.46 12.76 2 10 2z" stroke="#0261AA" stroke-width="1.5" stroke-linejoin="round"/><circle cx="10" cy="7.5" r="2" stroke="#0261AA" stroke-width="1.3"/></svg>`,
        },
        {
          text: "Strukturér områder og arbejdszoner",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="2" y="2" width="7" height="7" rx="1.5" stroke="#0261AA" stroke-width="1.4"/><rect x="11" y="2" width="7" height="7" rx="1.5" stroke="#0261AA" stroke-width="1.4"/><rect x="2" y="11" width="7" height="7" rx="1.5" stroke="#0261AA" stroke-width="1.4"/><rect x="11" y="11" width="7" height="7" rx="1.5" stroke="#0261AA" stroke-width="1.4"/></svg>`,
        },
        {
          text: "Skab klarhed i hverdagen",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 3a5 5 0 013.5 8.5l-.5.5v1.5a1 1 0 01-1 1h-4a1 1 0 01-1-1V12l-.5-.5A5 5 0 0110 3z" stroke="#0261AA" stroke-width="1.4" stroke-linejoin="round"/><line x1="8" y1="16.5" x2="12" y2="16.5" stroke="#0261AA" stroke-width="1.3" stroke-linecap="round"/><line x1="10" y1="1" x2="10" y2="2" stroke="#0261AA" stroke-width="1.3" stroke-linecap="round"/></svg>`,
        },
      ]}
    />

    <FunktionerCard
      id="digital-tjekliste"
      label="Enkel app til medarbejdere"
      title="Digital tjekliste (APP)"
      description="Medarbejdere får adgang til en overskuelig tjekliste i appen, hvor de kan se dagens opgaver og markere dem som udført."
      features={[
        {
          text: "Se opgaver hurtigt og nemt",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M2 10c2-4 5-6 8-6s6 2 8 6c-2 4-5 6-8 6s-6-2-8-6z" stroke="#0261AA" stroke-width="1.4" stroke-linejoin="round"/><circle cx="10" cy="10" r="2.5" stroke="#0261AA" stroke-width="1.3"/></svg>`,
        },
        {
          text: "Marker opgaver som færdige",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="3" y="3" width="14" height="14" rx="2.5" stroke="#0261AA" stroke-width="1.4"/><path d="M6.5 10.5l2.5 2.5 4.5-5" stroke="#0261AA" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
        },
        {
          text: "Brug som digital huskeseddel",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 2h10a1 1 0 011 1v14l-3.5-2.5L9 17l-3.5-2.5V3a1 1 0 011-1z" stroke="#0261AA" stroke-width="1.4" stroke-linejoin="round"/><line x1="7.5" y1="7" x2="12.5" y2="7" stroke="#0261AA" stroke-width="1.2" stroke-linecap="round"/><line x1="7.5" y1="10" x2="10.5" y2="10" stroke="#0261AA" stroke-width="1.2" stroke-linecap="round"/></svg>`,
        },
      ]}
    />

    <FunktionerCard
      id="dokumentation"
      label="Dokumentér arbejdet med billeder"
      title="Dokumentation"
      description="Hvis en opgave ikke kan udføres, eller noget ikke er som forventet, kan medarbejderen tage et billede og skrive en kort kommentar direkte i systemet."
      features={[
        {
          text: "Tag billeder direkte i appen",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="2" y="6" width="16" height="11" rx="2" stroke="#0261AA" stroke-width="1.4"/><circle cx="10" cy="12" r="2.8" stroke="#0261AA" stroke-width="1.3"/><path d="M7.5 6l1.2-2h2.6l1.2 2" stroke="#0261AA" stroke-width="1.3" stroke-linejoin="round"/><circle cx="15.5" cy="9" r="1" fill="#0261AA"/></svg>`,
        },
        {
          text: "Skriv korte forklaringer",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M13.5 3.5a2.12 2.12 0 013 3L7 16l-4 1 1-4 9.5-9.5z" stroke="#0261AA" stroke-width="1.4" stroke-linejoin="round"/><line x1="11.5" y1="5.5" x2="14.5" y2="8.5" stroke="#0261AA" stroke-width="1.2"/></svg>`,
        },
        {
          text: "Skab gennemsigtighed og undgå tvivl",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 2L3.5 5v5.5c0 4 2.9 7.5 6.5 8.5 3.6-1 6.5-4.5 6.5-8.5V5L10 2z" stroke="#0261AA" stroke-width="1.4" stroke-linejoin="round"/><path d="M7 10.5l2.5 2.5 4-4" stroke="#0261AA" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
        },
      ]}
    />

    <FunktionerCard
      id="fejlhaandtering"
      label="Håndtér fejl og afvigelser hurtigt"
      title="Fejlhåndtering"
      description="Opgaver kan markeres som ikke udført eller mangelfulde, så problemer bliver synlige med det samme og kan følges op."
      features={[
        {
          text: "Markér fejl eller mangler",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M10 3L2 17h16L10 3z" stroke="#0261AA" stroke-width="1.4" stroke-linejoin="round"/><line x1="10" y1="9" x2="10" y2="13" stroke="#0261AA" stroke-width="1.5" stroke-linecap="round"/><circle cx="10" cy="15.2" r="0.9" fill="#0261AA"/></svg>`,
        },
        {
          text: "Tilføj kommentarer og billeder",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M17 12a2 2 0 01-2 2H5l-3 3.5V4a2 2 0 012-2h11a2 2 0 012 2v8z" stroke="#0261AA" stroke-width="1.4" stroke-linejoin="round"/><circle cx="8" cy="7.5" r="1.3" stroke="#0261AA" stroke-width="1.1"/><path d="M5.5 11l2.5-2.5 2 2 2-2.5 2 3" stroke="#0261AA" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
        },
        {
          text: "Reagér hurtigt og effektivt",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M12 2L5 11h6l-3 7 9-10h-6l3-6z" stroke="#0261AA" stroke-width="1.4" stroke-linejoin="round"/></svg>`,
        },
      ]}
    />

    <FunktionerCard
      id="overblik"
      label="Få fuldt overblik over arbejdet"
      title="Overblik & historik"
      description="Se status på opgaver og få adgang til historik, så du altid kan dokumentere, hvad der er blevet udført."
      features={[
        {
          text: "Følg opgaver i realtid",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><polyline points="1.5,10 4.5,10 6.5,4 8.5,16 10.5,7.5 12.5,13 14.5,10 18.5,10" stroke="#0261AA" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
        },
        {
          text: "Se tidligere arbejde",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3.5 10A6.5 6.5 0 1010 3.5a6.5 6.5 0 00-5 2.3" stroke="#0261AA" stroke-width="1.4" stroke-linecap="round"/><path d="M3.5 2.5v4h4" stroke="#0261AA" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 7v3.5l2.5 1.5" stroke="#0261AA" stroke-width="1.3" stroke-linecap="round"/></svg>`,
        },
        {
          text: "Brug dokumentation ved behov",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M5 2h7.5L16 5.5V17a1 1 0 01-1 1H5a1 1 0 01-1-1V3a1 1 0 011-1z" stroke="#0261AA" stroke-width="1.4" stroke-linejoin="round"/><path d="M12 2v4h4" stroke="#0261AA" stroke-width="1.3" stroke-linejoin="round"/><path d="M7.5 12.5l2 2 3.5-3.5" stroke="#0261AA" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
        },
      ]}
    />

    <FunktionerCard
      id="kommunikation"
      label="Bedre kommunikation uden mails"
      title="Kommunikation & opfølgning"
      description="Kommunikationen foregår direkte i systemet, så alle parter har adgang til samme information og historik."
      features={[
        {
          text: "Mindre behov for mails og opkald",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><rect x="2" y="5" width="16" height="11" rx="2" stroke="#0261AA" stroke-width="1.4"/><path d="M2 7l8 5 8-5" stroke="#0261AA" stroke-width="1.3" stroke-linecap="round"/><line x1="13" y1="2" x2="17" y2="6" stroke="#0261AA" stroke-width="1.4" stroke-linecap="round"/><line x1="17" y1="2" x2="13" y2="6" stroke="#0261AA" stroke-width="1.4" stroke-linecap="round"/></svg>`,
        },
        {
          text: "Kommuniker direkte i systemet",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M3 3a1 1 0 011-1h9a1 1 0 011 1v5a1 1 0 01-1 1H7.5L4 11V9H4a1 1 0 01-1-1V3z" stroke="#0261AA" stroke-width="1.4" stroke-linejoin="round"/><path d="M8 13h1l3.5 2.5V13H14a1 1 0 001-1v-2" stroke="#0261AA" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
        },
        {
          text: "Let opfølgning på opgaver",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="7.5" stroke="#0261AA" stroke-width="1.4"/><path d="M10 6v4l2.5 2" stroke="#0261AA" stroke-width="1.4" stroke-linecap="round"/><path d="M15 14.5l1 2-2 .5" stroke="#0261AA" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
        },
      ]}
    />

    <FunktionerCard
      id="ekstra-funktioner"
      label="Designet til hverdagen"
      title="Ekstra funktioner"
      description="Funktioner, der gør hverdagen nemmere. Systemet er udviklet med fokus på fleksibilitet, brugervenlighed og support til forskellige brancher."
      features={[
        {
          text: "Dansk og engelsk sprog",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><circle cx="10" cy="10" r="8" stroke="#0261AA" stroke-width="1.4"/><path d="M2 10h16" stroke="#0261AA" stroke-width="1.2"/><path d="M10 2c-2.5 2.5-2.5 5.5 0 8s2.5 5.5 0 8" stroke="#0261AA" stroke-width="1.2"/><path d="M10 2c2.5 2.5 2.5 5.5 0 8s-2.5 5.5 0 8" stroke="#0261AA" stroke-width="1.2"/></svg>`,
        },
        {
          text: "Opsætning til forskellige brancher",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><line x1="3" y1="5" x2="17" y2="5" stroke="#0261AA" stroke-width="1.4" stroke-linecap="round"/><line x1="3" y1="10" x2="17" y2="10" stroke="#0261AA" stroke-width="1.4" stroke-linecap="round"/><line x1="3" y1="15" x2="17" y2="15" stroke="#0261AA" stroke-width="1.4" stroke-linecap="round"/><circle cx="7" cy="5" r="2" fill="white" stroke="#0261AA" stroke-width="1.3"/><circle cx="13" cy="10" r="2" fill="white" stroke="#0261AA" stroke-width="1.3"/><circle cx="9" cy="15" r="2" fill="white" stroke="#0261AA" stroke-width="1.3"/></svg>`,
        },
        {
          text: "Support og hjælp ved behov",
          icon: `<svg width="20" height="20" viewBox="0 0 20 20" fill="none"><path d="M4 10V9a6 6 0 0112 0v1" stroke="#0261AA" stroke-width="1.4" stroke-linecap="round"/><rect x="2.5" y="10" width="3.5" height="5" rx="1.5" stroke="#0261AA" stroke-width="1.3"/><rect x="14" y="10" width="3.5" height="5" rx="1.5" stroke="#0261AA" stroke-width="1.3"/><path d="M17.5 15v1.5a2 2 0 01-2 2H12" stroke="#0261AA" stroke-width="1.3" stroke-linecap="round"/><circle cx="12" cy="18.5" r="1.2" stroke="#0261AA" stroke-width="1.2"/></svg>`,
        },
      ]}
    />
  </div>
</section>
