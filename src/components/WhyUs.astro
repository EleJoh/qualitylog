---
const benefits = [
  {
    icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><circle cx="11" cy="11" r="9" stroke="#0261AA" stroke-width="1.5"/><circle cx="11" cy="11" r="4" stroke="#0261AA" stroke-width="1.5"/><circle cx="11" cy="11" r="1.5" fill="#1F4569"/></svg>`,
    title: "Bedre overblik",
    description: "Få et samlet overblik over alle opgaver og lokationer ét sted",
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><path d="M11 2L4 6v6c0 4.4 3.1 8.5 7 9.9 3.9-1.4 7-5.5 7-9.9V6L11 2z" stroke="#0261AA" stroke-width="1.5" stroke-linejoin="round"/><path d="M8 11l2 2 4-4" stroke="#0261AA" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`,
    title: "Færre fejl",
    description: "Dokumentation sikrer, at opgaver bliver udført korrekt",
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><circle cx="11" cy="11" r="9" stroke="#0261AA" stroke-width="1.5"/><path d="M11 7v4l2.5 2.5" stroke="#0261AA" stroke-width="1.5" stroke-linecap="round"/></svg>`,
    title: "Spar tid",
    description: "Slip for mails, opkald og manuelle opfølgninger",
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><circle cx="8" cy="8" r="3" stroke="#0261AA" stroke-width="1.5"/><circle cx="16" cy="14" r="3" stroke="#0261AA" stroke-width="1.5"/><path d="M11 8h2a3 3 0 013 3v0" stroke="#1F4569" stroke-width="1.5" stroke-linecap="round"/></svg>`,
    title: "Bedre samarbejde",
    description: "Skab gennemsigtighed mellem virksomhed og kunde",
  },
  {
    icon: `<svg width="22" height="22" viewBox="0 0 22 22" fill="none"><rect x="7" y="2" width="8" height="18" rx="2" stroke="#0261AA" stroke-width="1.5"/><path d="M10 17h2" stroke="#0261AA" stroke-width="1.5" stroke-linecap="round"/></svg>`,
    title: "Altid lige ved hånden",
    description: "Fungerer på både mobil og tablet – til både iOS og Android – og på dansk og engelsk.",
  },
];
---

<section class="bg-bgWhite px-6 lg:px-16 py-16 lg:py-24">
  <div class="max-w-screen-xl mx-auto">
    <!-- Heading -->
    <h2 class="reveal-up text-mobile_h3 lg:text-h3 text-black text-center mb-12">Derfor vælger virksomheder QualityLog</h2>

    <div class="flex flex-col gap-4 max-w-2xl mx-auto">
      {
        benefits.map((b, i) => (
          <div class="reveal-card bg-white rounded-2xl px-6 py-5 flex items-center gap-5 shadow-sm border border-graphic/30" data-delay={i * 70}>
            <div class="flex-shrink-0 w-11 h-11 rounded-xl bg-bgDarker flex items-center justify-center">
              <Fragment set:html={b.icon} />
            </div>
            <div>
              <p class="text5h_mobile lg:text-h5 font-semibold text-black">{b.title}</p>
              <p class="text-p_mobil lg:text-p text-grey">{b.description}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
